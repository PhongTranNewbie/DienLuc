@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Theo dõi doanh thu";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Doanh thu</title>
</head>
<body>
    <div class="container">
        <h2>Doanh thu</h2>
        <div class="row">
            <div class="col-md-6">
                <form method="post" action="@Url.Action("Index", "DoanhThu")">
                    <div class="form-group">
                        <label for="startdate">Từ ngày:</label>
                        <div class="input-group">
                            <input type="text" id="my_date_picker" class="form-control" name="startdate">
                            <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="enddate">Đến ngày:</label>
                        <div class="input-group">
                            <input type="text" id="my_date_picker1" class="form-control" name="enddate">
                            <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-calculator"></i></button>
                </form>
            </div>
        </div>
        <hr />
        @if (ViewBag.HD != null)
        {
            <div class="row">
                <div class="col-md-6">
                    <h3>Doanh thu</h3>
                    <p>Số hóa đơn: @ViewBag.HD</p>
                    <p>Tổng doanh thu: @ViewBag.DoanhThu đồng</p>
                </div>
            </div>
        }
    </div>
    <!-- Thêm phần tử canvas -->
    <div class="row">
        <div class="col-md-12">
            <canvas id="doanhThuChart" width="400" height="400"></canvas>
        </div>
    </div>
    <link href='https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/ui-lightness/jquery-ui.css'
          rel='stylesheet'>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="~/Scripts/datepicker-vi.js"></script>
    <script>
        jQuery(document).ready(function ($) {
            $("#my_date_picker, #my_date_picker1").datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true
            });
        });
    </script>
</body>

</html>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script type="text/javascript">
    $(function () {
        var doanhThuData = @Html.Raw(Json.Serialize(ViewBag.DoanhThuData));

        var ctx = document.getElementById('doanhThuChart').getContext('2d');
        var myChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: doanhThuData.labels,
                datasets: [{
                    label: 'Doanh thu',
                    data: doanhThuData.data,
                    backgroundColor: 'rgba(54, 162, 235, 0.2)',
                    borderColor: 'rgba(54, 162, 235, 1)',
                    borderWidth: 1
                }]
            },
            options: {
                scales: {
                    yAxes: [{
                        ticks: {
                            beginAtZero: true
                        }
                    }]
                }
            }
        });
    });
</script>

