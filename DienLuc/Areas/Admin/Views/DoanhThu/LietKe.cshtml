@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Theo dõi hóa đơn";
}

<div class="container">
    <h2>Theo dõi hóa đơn</h2>
    <div class="row">
        <div class="col-md-6">
            <form method="post" action="@Url.Action("LietKe", "DoanhThu")">
                <div class="form-group">
                    <label for="startdate">Từ ngày:</label>
                    <div class="input-group">
                        <input type="text" id="startdate" class="form-control" name="startdate">
                        <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                    </div>
                </div>
                <div class="form-group">
                    <label for="enddate">Đến ngày:</label>
                    <div class="input-group">
                        <input type="text" id="enddate" class="form-control" name="enddate">
                        <span class="input-group-text"><i class="bi bi-calendar"></i></span>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-calculator"></i></button>
            </form>
        </div>
    </div>
    <hr />
    @if (ViewBag.HoaDons != null)
    {
        <div id="results">
            <div class="row">
                <div class="col-md-6">
                    <h3>Thông tin hóa đơn</h3>
                    <p>Hóa đơn đã thanh toán (không nợ): @ViewBag.DaThanhToanThuanCount</p>
                    <p>Hóa đơn chưa thanh toán: @ViewBag.ChuaThanhToanCount</p>
                    <p>Hóa đơn còn nợ: @ViewBag.ConNoCount</p>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <canvas id="hoaDonChart" width="400" height="400"></canvas>
                </div>
            </div>
        </div>
    }
</div>

<link href="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/ui-lightness/jquery-ui.css" rel="stylesheet">

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
<script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="~/Scripts/datepicker-vi.js"></script>

<script>
    jQuery(document).ready(function ($) {
        $("#startdate, #enddate").datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true
        });

        var chartData = @Html.Raw(Json.Serialize(ViewBag.ChartData));
        if (chartData) {
            renderChart(chartData);
        }
    });

    function renderChart(chartData) {
        var ctx = document.getElementById('hoaDonChart').getContext('2d');
        if (chartData.datasets.some(dataset => dataset.data.some(count => count > 0))) {
            var myChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: chartData.labels,
                    datasets: chartData.datasets
                },
                options: {
                    scales: {
                        yAxes: [{
                            stacked: true,
                            ticks: {
                                beginAtZero: true
                            }
                        }],
                        xAxes: [{
                            stacked: true
                        }]
                    }
                }
            });
        } else {
            console.log("Không có dữ liệu để vẽ biểu đồ.");
        }
    }
</script>
