@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<KhachHang>

@{
    ViewData["Title"] = "Danh sách khách hàng";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

}

<h1>@ViewData["Title"]</h1>

<table class="table">
    <thead>
        <tr class="table-warning">
            <th>Mã khách hàng</th>
            <th>CCCD</th>
            <th>Họ và tên</th>
            <th>Ngày sinh</th>
            <th>Địa chỉ</th>
            <th>Số điện thoại</th>
            <th>Email</th>
        </tr>
    </thead>
    <tbody id="da">
        @{
            int i = 0;
            string @cls = "table-success";
        }
        @foreach (var item in Model)
        {
            i = i + 1;
            cls = "table-success";
            if (i % 2 == 0)
            {
                cls = "table-primary";
            }
            <tr class="@cls">
                <td>@item.MaKh</td>
                <td>@item.Cccd</td>
                <td>@item.Ho @item.Ten</td>
                <td>@item.NgaySinh.ToShortDateString()</td>
                <td>@item.DiaChi</td>
                <td>@item.SoDt</td>
                <td>@item.Email</td>
            </tr>
        }
    </tbody>
</table>
<div class="center" id="paginationContainerD">
@Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }), new PagedListRenderOptions
{
    LiElementClasses = new string[] { "page-item" },
    PageClasses = new string[] { "page-link" }
})
</div>
@section Scripts {
    <script>
        function filterByMaHoaDon() {
            var maNhanVien = $('#txtMaHoaDon').val(); // Lấy giá trị mã nhân viên

            $.ajax({
                url: '/admin/taikhoanad/FilterByMaKH', // Đường dẫn đến action trong controller để xử lý yêu cầu
                type: 'GET',
                data: { maNhanVien: maNhanVien },
                success: function (result) {
                    // Cập nhật từng cell trong bảng
                    var tableRows = $(result).find('tbody tr');
                    $('#da').empty(); // Xóa hết dữ liệu cũ

                    // Thêm dữ liệu mới vào bảng
                    $.each(tableRows, function (index, row) {
                        $('#da').append(row);
                    });

                    // Cập nhật nội dung của phần tử HTML mà bạn muốn hiển thị dữ liệu
                    $('#paginationContainerD').html($(result).find('#paginationContainerD').html());
                },
                error: function () {
                    console.log('Đã xảy ra lỗi khi lấy dữ liệu từ máy chủ.');
                }
            });
        }

        // Function để xử lý chuyển trang
        function updateData(pageNumber) {
            var maNhanVien = $('#txtMaHoaDon').val(); // Lấy giá trị mã nhân viên

            $.ajax({
                url: '/admin/taikhoanad/FilterByMaKH', // Đường dẫn đến action trong controller để xử lý yêu cầu
                type: 'GET',
                data: { maNhanVien: maNhanVien, page: pageNumber }, // Truyền thêm số trang
                success: function (result) {
                    // Cập nhật từng cell trong bảng
                    var tableRows = $(result).find('tbody tr');
                    $('#da').empty(); // Xóa hết dữ liệu cũ

                    // Thêm dữ liệu mới vào bảng
                    $.each(tableRows, function (index, row) {
                        $('#da').append(row);
                    });

                    // Cập nhật nội dung của phần tử HTML mà bạn muốn hiển thị dữ liệu
                    $('#paginationContainerD').html($(result).find('#paginationContainerD').html());
                },
                error: function () {
                    console.log('Đã xảy ra lỗi khi lấy dữ liệu từ máy chủ.');
                }
            });
        }

        

        // Bind sự kiện cho các liên kết phân trang
        $(document).on('click', '#paginationContainerD a', function (e) {
            e.preventDefault(); // Ngăn chặn hành vi mặc định của các liên kết phân trang
            var pageUrl = $(this).attr('href');
            var pageNumber = pageUrl.substring(pageUrl.indexOf('page=') + 5);
            updateData(pageNumber); // Gọi hàm để cập nhật dữ liệu khi người dùng chuyển trang
        });

    </script>
}