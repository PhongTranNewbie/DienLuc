@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<ThongBao>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

}

<h1>Danh sách thông báo</h1>

<p>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i></a>
</p>
<table class="table">
    <thead>
        <tr class="table-warning">

            <th>
                Ngày thông báo
            </th>
            <th>
                Ngày hết hạn
            </th>
            <th>
                Mã hóa đơn
            </th>
            <th>
                Nội dung
            </th>
        </tr>
    </thead>
    <tbody id="ka">
        @{
            int i = 0;
            string @cls = "table-success";

        }
@foreach (var item in Model) {
            i = i + 1;
            cls = "table-success";
            if (i % 2 == 0)
            {
                cls = "table-primary";
            }
        <tr class="@cls">

            <td>
                @Html.DisplayFor(modelItem => item.NgayThongBao)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayHetHan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaHdNavigation.MaHd)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.NoiDung)
            </td>
        </tr>
}
    </tbody>
</table>
<div class="center" id="paginationContainerV">
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }), new PagedListRenderOptions
{
    LiElementClasses = new string[] { "page-item" },
    PageClasses = new string[] { "page-link" }
})
@section Scripts {
    <script>
        // Biến toàn cục để lưu trữ ID của setTimeout
        var timeoutId;

        function filterByMaHoaDon() {
            // Clear the previous timeout if it exists
            clearTimeout(timeoutId);

            // Get the value of the invoice ID
            var maCT = $('#txtMaHoaDon').val();

            // Set a timeout to send the AJAX request after 500ms of inactivity
            timeoutId = setTimeout(function () {
                $.ajax({
                        url: '/Admin/ThongBao/LocChiTiet',
                    type: 'GET',
                    data: { maCT: maCT, page: 1 },
                    success: function (result) {
                            $('#ka').html($(result).find('#ka').html());
                            $('#paginationContainerV').html($(result).find('#paginationContainerV').html());
                    },
                    error: function () {
                        console.log('An error occurred while fetching data from the server.');
                    }
                });
            }, 500); // Wait for 500ms before sending the AJAX request
        }
    </script>
}