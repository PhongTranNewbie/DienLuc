@using DienLuc.Models;
@{
    Layout = "~/Areas/KhachHang/Views/Shared/_LayoutLoginKH.cshtml";

}

@model TaiKhoan;
<h3>Công ty điện lực</h3>
<h4>Đăng nhập cho nhân viên</h4>

@*<form class="pt-3> *@
@using (Html.BeginForm("Login", "AccountEmployee", FormMethod.Post))
{
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group">
        @Html.TextBoxFor(x => x.MaTk, new { @class = "form-control form-control-lg", placeholder = "Tài khoản", required = "required", autofocus = "autofocus" })
        @*                                     <input type="email" class="form-control form-control-lg" id="exampleInputEmail1" placeholder="Username">
    *@
    </div>
    <div class="form-group">
        @Html.TextBoxFor(x => x.Mk, new { @class = "form-control form-control-lg", placeholder = "Mật khẩu", type = "password" })

        @*                                     <input type="password" class="form-control form-control-lg" id="exampleInputPassword1" placeholder="Password">
    *@
    </div>
    <div class="mt-3">
        <button class="btn btn-block btn-lg font-weight-medium auth-form-btn custom-btn" type="submit">Đăng nhập</button>
    </div>
} @* </form> *@

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}        