@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<ChiTietSddien>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
    var dongHoDienList = ViewBag.DHD as List<DienLuc.Models.DongHoDien>;
    var khachHangList = ViewBag.KhachHangList as List<DienLuc.Models.KhachHang>;
}

<div class="row" style="border: 50px;">

    <div class="col-md-3">
        <div class="input-group">
            <input type="text" id="my_date_picker" class="form-control" placeholder="Từ ngày">
            <span class="input-group-text"><i class="bi bi-calendar"></i></span>
        </div>
    </div>
    <div class="col-md-3">
        <div class="input-group">
            <input type="text" id="my_date_picker1" class="form-control" placeholder="Đến ngày">
            <span class="input-group-text"><i class="bi bi-calendar"></i></span>
        </div>
    </div>

</div>


<h1 class="mt-4">Danh mục cho chi tiết sử dụng điện</h1>

<p>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i></a>
</p>
<table id="ct" class="table mt-4">
    <thead>
        <tr class="table-warning">
            <th>
                Id
            </th>

            <th>
                Mã đồng hồ
            </th>
            <th>
                Mã nhân viên
            </th>
            <th>
                Chỉ số điện
            </th>
            <th>
                Ngày lấy thông tin
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 0;
            string @cls = "table-success";
        }
        @foreach (var item in Model)
        {
            i = i + 1;
            cls = "table-success";
            if (i % 2 == 0)
            {
                cls = "table-primary";
            }
            <tr class="@cls">
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.MaDhNavigation.MaDh)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaNv)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChiSoDien)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayLayThongTin)
                </td>
                <td>
                    <a class="btn btn-danger btn-sm rounded" asp-action="Edit" asp-route-id="@item.Id">
                        <i class="bi bi-pencil"></i>
                    </a> |

                    <a onclick="if (confirm('Xác nhận xóa chi tiết này hay không?') == true) 
                        {location.href='/admin/chitietsddien/Xoa/@item.Id'}" class="btn btn-danger btn-sm rounded">
                        <i class="bi bi-x-circle"></i>
                    </a>                           


                </td>
            </tr>
        }
    </tbody>
</table>
<div class="center" id="paginationContainer">
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }), new PagedListRenderOptions
{
    LiElementClasses = new string[] { "page-item" },
    PageClasses = new string[] { "page-link" }
})
</div>
@section Scripts {
    <link href='https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/ui-lightness/jquery-ui.css'
          rel='stylesheet'>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="~/Scripts/datepicker-vi.js"></script>

    <script>

        // Define variables to store filter values
        var fromDate = "";
        var toDate = "";

        // Function to update filter values
        function updateFilterValues() {
            fromDate = $('#my_date_picker').val();
            toDate = $('#my_date_picker1').val();
            // Update pagination links
            updatePaginationLinks(1); // Assuming we reset to the first page after filter change
        }


        // Function to update pagination links
        function updatePaginationLinks(pageNumber) {
            // Update URL for pagination links including fromDate and toDate parameters
            var url = '/admin/chitietsddien/LocChiTiet?page=' + pageNumber + '&fromDate=' + fromDate + '&toDate=' + toDate;
            return url;
        }

        // Bind event handler for pagination links
        $(document).on('click', '#paginationContainer a', function (e) {
            e.preventDefault(); // Prevent default behavior of the pagination links
            var pageUrl = $(this).attr('href');
            $.get(pageUrl, function (data) {
                // Update the table content and pagination links with the received data
                $('#ct').html($(data).find('#ct').html());
                $('#paginationContainer').html($(data).find('#paginationContainer').html());

                // Update filter values based on the date pickers
                updateFilterValues();

                // Trigger filter function with the current page number
                filterByDate(pageUrl.substring(pageUrl.indexOf('page=') + 5));
            });
        });

        // Initialize Datepickers with Vietnamese localization
        $("#my_date_picker, #my_date_picker1").datepicker({
            dateFormat: "yy-mm-dd",
            changeMonth: true,
            changeYear: true
        });

        // Update filter values and trigger filter when datepicker values change
        $('#my_date_picker, #my_date_picker1').change(function () {
            updateFilterValues();
            filterByDate(1); // Assuming we reset to the first page after filter change
        });

        // Global variable to store the ID of setTimeout
        var timeoutId;

        function filterByMaHoaDon() {
            // Clear the previous timeout if it exists
            clearTimeout(timeoutId);

            // Get the value of the invoice ID
            var maCT = $('#txtMaHoaDon').val();

            // Set a timeout to send the AJAX request after 500ms of inactivity
            timeoutId = setTimeout(function () {
                $.ajax({
                    url: '/admin/chitietsddien/LocChiTiet',
                    type: 'GET',
                    data: { maCT: maCT, page: 1 },
                    success: function (result) {
                        $('#dh tbody').html($(result).find('tbody').html());
                        $('#paginationContainer').html($(result).find('#paginationContainer').html());
                    },
                    error: function () {
                        console.log('An error occurred while fetching data from the server.');
                    }
                });
            }, 500); // Wait for 500ms before sending the AJAX request
        }

        function filterByDate(pageNumber) {
            // Get the values of fromDate and toDate from the input fields
            var fromDate = $('#my_date_picker').val();
            var toDate = $('#my_date_picker1').val();

            // Send an AJAX request to the LocChiTiet action in the controller
            $.ajax({
                url: '/admin/chitietsddien/LocChiTiet',
                type: 'GET',
                data: {
                    fromDate: fromDate,
                    toDate: toDate,
                    page: pageNumber
                },
                success: function (data) {
                    // Update the table content and pagination links with the received data
                    $('#ct').html($(data).find('#ct').html());
                    $('#paginationContainer').html($(data).find('#paginationContainer').html());
                },
                error: function (xhr, status, error) {
                    console.error(error);
                }
            });
        }

    </script>
}


