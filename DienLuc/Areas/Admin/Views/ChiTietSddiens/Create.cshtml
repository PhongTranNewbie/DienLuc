@model DienLuc.Models.ChiTietSddien

@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

}
<div class="page-header">
    <nav style="--cui-breadcrumb-divider: '>';" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Danh sách đồng hồ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Thêm mới</li>
        </ol>
    </nav>
</div>
<hr />
<div class="row">
    <h4>Chi tiết chỉ số sử dụng điện</h4>
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MaDh" class="control-label">Mã đồng hồ</label>
                <select asp-for="MaDh" class="form-control" asp-items="ViewBag.MaDh" onchange="getChiSoCu(this)">
                </select>
            </div>
            <div class="form-group">
                <label asp-for="NgayLayThongTin" class="control-label">Ngày lấy thông tin</label>
                <input asp-for="NgayLayThongTin" class="form-control"/>
                <span asp-validation-for="NgayLayThongTin" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MaNv" class="control-label">Mã nhân viên</label>
                <select asp-for="MaNv" class ="form-control" asp-items="ViewBag.MaNv"></select>
            </div>
            <div class="form-group">
                <label asp-for="ChiSoDien" class="control-label" >Chỉ số điện</label>
                <input asp-for="ChiSoDien" class="form-control"  />
                <span asp-validation-for="ChiSoDien" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input class="btn btn-primary" type="submit" value="Hoàn thành"/>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
