@model DienLuc.Models.TaiKhoan;

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}

<h4>Tạo tài khoản cho nhân viên</h4>
@using (Html.BeginForm("Create", "TaiKhoans", FormMethod.Post))
{
    <div class="form-group">
        @Html.TextBoxFor(x => x.MaTk, new { @class = "form-control form-control-lg", placeholder = "MaTk", required = "required", autofocus = "autofocus" })
    </div>
    <div class="form-group">
        @Html.TextBoxFor(x => x.Mk, new { @class = "form-control form-control-lg", placeholder = "Mk", type = "password" })
    </div>
    <div class="form-group">
        @Html.TextBoxFor(x => x.LoaiTk, new { @class = "form-control form-control-lg", placeholder = "LoaiTk" })
    </div>
    <div class="mt-3">
        <button class="btn btn-block btn-lg font-weight-medium auth-form-btn custom-btn" type="submit">Hoàn thành</button>
    </div>
}
                            
                        