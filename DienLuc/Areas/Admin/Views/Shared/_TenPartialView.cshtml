@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<HoaDon>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

}
<div>
    <input type="text" id="my_date_picker" placeholder="Từ ngày">
    <input type="text" id="my_date_picker1" placeholder="Đến ngày">
    <button onclick="filterByDateHD(1)">Lọc</button>
</div>
<div class="row">
    <div class="col-md-4">
        <div class="form-group">
            <label for="trangThai">Trạng thái:</label>
            <select id="trangThai" class="form-control">
                <option value="">Tất cả</option>
                <option value="Đã thanh toán">Đã thanh toán</option>
                <option value="Chưa thanh toán">Chưa thanh toán</option>
            </select>
        </div>
    </div>
</div>
<h1>Danh sách hóa đơn</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Thêm mới</a>
</p>

<table id="hoaDonTable" class="table">
    <thead>
        <tr class="table-warning">
            <th>
                Mã hóa đơn
            </th>
            <th>
                Ngày tạo
            </th>
            <th>
                Ngày đến hạn
            </th>
            <th>
                Ngày thanh toán
            </th>
            <th>
                Chỉ số cũ
            </th>
            <th>
                Chỉ số mới
            </th>
            <th>
                Chỉ số tiêu thụ
            </th>
            <th>
                Thuế
            </th>
            <th>
                Số nợ
            </th>
            <th>
                Số tiền cần thanh toán
            </th>
            <th>
                Số tiền đã thanh toán
            </th>
            <th>
                Phương pháp thanh toán
            </th>
            <th>
                Mã đồng hồ
            </th>
            <th>
                Trạng thái
            </th>
            <th>
                Mã khách hàng
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @{
            int i = 0;
            string @cls = "table-success";

        }
        @foreach (var item in Model)
        {
            i = i + 1;
            cls = "table-success";
            if (i % 2 == 0)
            {
                cls = "table-primary";
            }
            <tr class="@cls">
                <td>
                    @Html.DisplayFor(modelItem => item.MaHd)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayTao)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayDenHan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayThanhToan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChiSoCu)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChiSoMoi)
                </td>
                <td>
                    @(item.ChiSoMoi - item.ChiSoCu)
                </td>
                <td>
                    @if (i < ViewBag.ListThue.Count) // Kiểm tra chỉ mục trước khi truy cập
                    {

                        @string.Format("{0:N0}", ViewBag.ListThue[i])
                    }
                </td>
                <td>
                    @string.Format("{0:N0}", item.SoNo)
                </td>
                <td>
                    @string.Format("{0:N0}", item.SoTienCanThanhToan)
                </td>
                <td>
                    @string.Format("{0:N0}", item.SoTienDaThanhToan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaPtttoanNavigation.PhuongPhapTt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaChiTietSddienNavigation.MaDh)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TrangThai)
                </td>
                <td>

                    @Html.DisplayFor(modelItem => item.MaChiTietSddienNavigation.MaDhNavigation.MaKh)

                </td>



                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.MaHd">Chỉnh sửa</a> |
                    <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.MaHd">Chi tiết</a> |
                    <a class="btn btn-primary" asp-action="Delete" asp-route-id="@item.MaHd">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<div id="paginationContainer">
    @Html.PagedListPager(Model, page => Url.Action("LocTheoNgayHD", new { page = page }), new PagedListRenderOptions
{
    LiElementClasses = new string[] { "page-item" },
    PageClasses = new string[] { "page-link" }
})
</div>
@section Scripts {
    <link href='https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/ui-lightness/jquery-ui.css'
          rel='stylesheet'>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#trangThai').change(function () {
                var trangThai = $('#trangThai').val();
                $.ajax({
                    url: '/admin/HoaDon/LocTheo',
                    type: 'GET',
                    data: { trangThai: trangThai, maDh: maDh, maKh: maKh },
                    success: function (result) {
                        $('#hoaDonTable tbody').html($(result).find('tbody').html());
                        // Cập nhật phân trang nếu cần
                        $('#paginationContainer').html($(result).find('#paginationContainer').html());
                    },
                    error: function () {
                        console.log('Đã xảy ra lỗi khi lấy dữ liệu từ máy chủ.');
                    }
                });
            });
        });
        // Define variables to store filter values
        var fromDate = "";
        var toDate = "";

        // Function to update filter values
        function updateFilterValues() {
            fromDate = $('#my_date_picker').val();
            toDate = $('#my_date_picker1').val();
            // Update pagination links
            updatePaginationLinks(1); // Assuming we reset to the first page after filter change
        }


        // Function to update pagination links
        function updatePaginationLinks(pageNumber) {
            // Update URL for pagination links including fromDate and toDate parameters
            var url = '/admin/Hoadon/LocTheoNgayHD?page=' + pageNumber + '&fromDate=' + fromDate + '&toDate=' + toDate;
            return url;
        }

        // Bind event handler for pagination links
        $(document).on('click', '#paginationContainer a', function (e) {
            e.preventDefault(); // Prevent default behavior of the pagination links
            var pageUrl = $(this).attr('href');
            $.get(pageUrl, function (data) {
                // Update the table content and pagination links with the received data
                $('#hoaDonTable').html($(data).find('#hoaDonTable').html());
                $('#paginationContainer').html($(data).find('#paginationContainer').html());

                // Update filter values based on the date pickers
                updateFilterValues();

                // Trigger filter function with the current page number
                filterByDateHD(pageUrl.substring(pageUrl.indexOf('page=') + 5));
            });
        });




        jQuery(document).ready(function ($) {
            // Initialize Datepickers
            $('#my_date_picker').datepicker();
            $('#my_date_picker1').datepicker();

            // Update filter values and trigger filter when datepicker values change
            $('#my_date_picker, #my_date_picker1').change(function () {
                updateFilterValues();

            });

            // Trigger filter on page load

        });

        function filterByDateHD(pageNumber) {
            // Get the values of fromDate and toDate from the input fields
            var fromDate = $('#my_date_picker').val();
            var toDate = $('#my_date_picker1').val();

            // Send an AJAX request to the LocChiTiet action in the controller
            $.ajax({
                url: '/admin/Hoadon/LocTheoNgayHD',
                type: 'GET',
                data: {
                    fromDate: fromDate,
                    toDate: toDate,
                    page: pageNumber
                },
                success: function (data) {
                    // Update the table content and pagination links with the received data
                    $('#hoaDonTable').html($(data).find('#hoaDonTable').html());
                    $('#paginationContainer').html($(data).find('#paginationContainer').html());
                },
                error: function (xhr, status, error) {
                    console.error(error);
                }
            });
        }

    </script>
}


