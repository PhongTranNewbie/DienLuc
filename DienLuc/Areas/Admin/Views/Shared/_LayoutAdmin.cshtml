@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Required meta tags -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/normalize/8.0.1/normalize.min.css">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap-grid.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Purple Admin</title>
    <!-- plugins:css -->
    <link rel="stylesheet" href="~/LayoutAdmin/assets/vendors/mdi/css/materialdesignicons.min.css">
    <link rel="stylesheet" href="~/LayoutAdmin/assets/vendors/css/vendor.bundle.base.css">
    <!-- endinject -->
    <!-- Plugin css for this page -->
    <!-- End plugin css for this page -->
    <!-- inject:css -->
    <!-- endinject -->
    <!-- Layout styles -->
    <link rel="stylesheet" href="~/LayoutAdmin/assets/css/style.css">
    <!-- End layout styles -->
    <link rel="shortcut icon" href="~/LayoutAdmin/assets/images/favicon.ico" />
    <style>
        
        .center {
            display: flex;
            justify-content: center;
            margin-block: 10px;
        }

    
        .custom-bootstrap-icon {
            display: inline-block;
            font-family: bootstrap-icons !important;
            font-style: normal;
            font-weight: 400 !important;
            font-variant: normal;
            text-transform: none;
            line-height: 1;
            vertical-align: -.125em;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
            font-size: 1.125rem;
            line-height: 1;
            margin-left: auto;
            color: #bba8bff5;
        }
        /* CSS để tùy chỉnh kiểu dáng của select box */
        .custom-select {
            appearance: none;
            background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path fill="%23333" d="M10 12l-6-6H4l6 6 6-6h.001l-.001.002L16 6l-6 6z"/></svg>');
            background-repeat: no-repeat;
            background-position-x: calc(100% - 10px);
            background-position-y: 50%;
            padding-right: 2.25rem;
            border: 1px solid #ced4da;
            border-radius: .25rem;
            padding-top: .375rem;
            padding-bottom: .375rem;
            font-size: 1rem;
            line-height: 1.5;
        }
    </style>
</head>
<body>

    <!-- partial:partials/_navbar.html -->
    <nav class="navbar default-layout-navbar mt-3 col-lg-12 col-12 p-0 fixed-top d-flex flex-row">
        <div class="text-center navbar-brand-wrapper d-flex align-items-center justify-content-center">
            <a class="navbar-brand brand-logo" href="index.html">
                Điện lực
            </a>
            <a class="navbar-brand brand-logo-mini" href="index.html"><img src="~/LayoutAdmin/assets/images/logo-mini.svg" alt="logo" /></a>
        </div>
        <div class="navbar-menu-wrapper d-flex align-items-stretch">
            <button class="navbar-toggler navbar-toggler align-self-center" type="button" data-toggle="minimize">
                <span class="mdi mdi-menu"></span>
            </button>
            <div class="search-field d-none d-md-block">
                <form class="d-flex align-items-center h-100" action="#">
                    <div class="input-group">
                        <div class="input-group-prepend bg-transparent">
                            <i class="input-group-text border-0 mdi mdi-magnify"></i>
                        </div>
                        <input type="text" id="txtMaHoaDon" class="form-control bg-transparent border-0" placeholder="Tìm kiếm" oninput="filterByMaHoaDon()">
                    </div>
                </form>
            </div>
            <ul class="navbar-nav navbar-nav-right">
                <li class="nav-item nav-profile dropdown">
                    <a class="nav-link dropdown-toggle" id="profileDropdown" href="#" data-bs-toggle="dropdown" aria-expanded="false">
                        <div class="nav-profile-img">
                            <img src="~/LayoutAdmin/assets/images/faces/face1.jpg" alt="image">
                            <span class="availability-status online"></span>
                        </div>
                        <div class="nav-profile-text">
                            <p class="mb-1 text-black">Tài khoản</p>
                        </div>
                    </a>
                    <div class="dropdown-menu navbar-dropdown" aria-labelledby="profileDropdown">
                        <a class="dropdown-item" href="/admin/taikhoan/ThongTinNV">
                            <i class="mdi mdi-cached me-2 text-success"></i> Thông tin
                        </a>
                        <div class="dropdown-divider"></div>
                        <a class="dropdown-item" href="/admin/taikhoanad/dangxuat">
                            <i class="mdi mdi-logout me-2 text-primary"></i> Đăng xuất
                        </a>
                    </div>
                </li>
                <li class="nav-item d-none d-lg-block full-screen-link">
                    <a class="nav-link">
                        <i class="mdi mdi-fullscreen" id="fullscreen-button"></i>
                    </a>
                </li>
                
                
                <li class="nav-item nav-logout d-none d-lg-block">
                    <a class="nav-link" href="#">
                        <i class="mdi mdi-power"></i>
                    </a>
                </li>
                <li class="nav-item nav-settings d-none d-lg-block">
                    <a class="nav-link" href="#">
                        <i class="mdi mdi-format-line-spacing"></i>
                    </a>
                </li>
            </ul>
            <button class="navbar-toggler navbar-toggler-right d-lg-none align-self-center" type="button" data-toggle="offcanvas">
                <span class="mdi mdi-menu"></span>
            </button>
        </div>
    </nav>
    <!-- partial -->
    <div class="container-fluid page-body-wrapper">
        <!-- partial:partials/_sidebar.html -->
        <nav class="sidebar sidebar-offcanvas" id="sidebar">
            <ul class="nav">
                
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#ui-basic-dongho" aria-expanded="false" aria-controls="ui-basic-dongho">
                        <span class="menu-title">Đồng hồ</span>
                        <i class="menu-arrow"></i>
                        <i class="mdi mdi-crosshairs-gps menu-icon"></i>
                    </a>
                    <div class="collapse" id="ui-basic-dongho">
                        <ul class="nav flex-column sub-menu">
                            <li class="nav-item"> <a class="nav-link" href="/admin/DanhsachSDDien">Chi tiết sử dụng điện</a></li>
                            <li class="nav-item"> <a class="nav-link" href="/admin/Danhsachdongho">Thông tin đồng hồ</a></li>
                        </ul>
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link" data-bs-toggle="collapse" href="#ui-basic-thongke" aria-expanded="false" aria-controls="ui-basic-thongke">
                        <span class="menu-title">Thống kê</span>
                        <i class="menu-arrow"></i>
                        <i class="mdi mdi-crosshairs-gps menu-icon"></i>
                    </a>
                    <div class="collapse" id="ui-basic-thongke">
                        <ul class="nav flex-column sub-menu">
                            <li class="nav-item"> <a class="nav-link" href="/admin/DoanhThu">Doanh thu từng hóa đơn</a></li>
                            <li class="nav-item"> <a class="nav-link" href="/admin/DoanhThu/doanhthuthang">Doanh thu theo tháng</a></li>
                            <li class="nav-item"> <a class="nav-link" href="/admin/DoanhThu/lietke">Thống kê số lượng hóa đơn</a></li>
                        </ul>
                    </div>
                </li>


                @if (HttpContextAccessor.HttpContext.Session.GetString("Role") != null 
                && HttpContextAccessor.HttpContext.Session.GetString("Role") == "TK1")
                {
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="collapse" href="#ui-basic1" aria-expanded="false" aria-controls="ui-basic1">
                            <span class="menu-title">Nhân viên</span>
                            <i class="menu-arrow"></i>
                            <i class="mdi mdi-crosshairs-gps menu-icon"></i>
                        </a>
                        <div class="collapse" id="ui-basic1">
                            <ul class="nav flex-column sub-menu">
                                <li class="nav-item"> <a class="nav-link" href="/admin/taikhoan/TaoTaiKhoanVaThongTinNV">Thêm nhân viên</a></li>
                                <li class="nav-item"> <a class="nav-link" href="/admin/taikhoanad/DanhSachNV">Danh sách nhân viên</a></li>
                            </ul>
                        </div>
                    </li>
                    
                }
                <li class="nav-item">
                    <a class="nav-link" href="/admin/danhsachhoadon">
                        <span class="menu-title">Danh sách hóa đơn</span>
                        <i class="mdi mdi-chart-bar menu-icon"></i>
                    </a>
                </li>
                
                <li class="nav-item">
                    <a class="nav-link" href="/admin/taikhoanad/DanhSachKH">
                        <span class="menu-title">Danh sách khách hàng</span>
                        <i class="mdi mdi-format-list-bulleted menu-icon"></i>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/admin/thongbao/danhsachthongbao">
                        <span class="menu-title">Thông báo</span>
                        <i class="bi bi-bell custom-bootstrap-icon"></i>
                    </a>

                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Admin/DoanhThu">
                        <span class="menu-title">Thống kê</span>
                        <i class="bi bi-person-circle custom-bootstrap-icon"></i>
                    </a>

                </li>

            </ul>
        </nav>
        <!-- partial -->
        <div class="main-panel">
            <div class="content-wrapper">
                <div style="overflow-x:auto;" class="content-wrapper">
                    @{
                        var errorMessage = TempData["errorMessage"]?.ToString();
                        var successMessage = TempData["successMessage"]?.ToString();
                    }
                    @if(!string.IsNullOrWhiteSpace(@successMessage))
                    {
                        <div class="alert alert-success">
                            <b>Hoàn thành: </b>@successMessage
                            <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-success">
                            <b>Lỗi: </b>@errorMessage
                            <button type="button" class="btn-close float-end" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    @RenderBody()
                    @RenderSection("content", required: false)

                    @RenderSection("Scripts", required: false)
                </div>
                <!-- content-wrapper ends -->
                <!-- partial:partials/_footer.html -->
                <footer class="footer">
                    <div class="container-fluid d-flex justify-content-between">
                    </div>
                </footer>
                <!-- partial -->
            </div>
        </div>
        <!-- main-panel ends -->
    </div>
        <!-- page-body-wrapper ends -->
    
    <!-- container-scroller -->
    <!-- plugins:js -->
    <script src="~/LayoutAdmin/assets/vendors/js/vendor.bundle.base.js"></script>
    <!-- endinject -->
    <!-- Plugin js for this page -->
    <script src="~/LayoutAdmin/assets/vendors/chart.js/Chart.min.js"></script>
    <script src="~/LayoutAdmin/assets/js/jquery.cookie.js" type="text/javascript"></script>
    <!-- End plugin js for this page -->
    <!-- inject:js -->
    <script src="~/LayoutAdmin/assets/js/off-canvas.js"></script>
    <script src="~/LayoutAdmin/assets/js/hoverable-collapse.js"></script>
    <script src="~/LayoutAdmin/assets/js/misc.js"></script>
    <!-- endinject -->
    <!-- Custom js for this page -->
    <script src="~/LayoutAdmin/assets/js/dashboard.js"></script>
    <script src="~/LayoutAdmin/assets/js/todolist.js"></script>
    <!-- End custom js for this page -->
</body>
</html>