@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<HoaDon>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

}
<div class="row">
<div class="col-md-3">
    <div class="input-group">
        <input type="text" id="my_date_picker" class="form-control" placeholder="Từ ngày" oninput="filterByDateHD(1)">
        <span class="input-group-text"><i class="bi bi-calendar"></i></span>
    </div>
</div>

<div class="col-md-3">
    <div class="input-group">
        <input type="text" id="my_date_picker1" class="form-control" placeholder="Đến ngày" oninput="filterByDateHD(1)">
        <span class="input-group-text"><i class="bi bi-calendar"></i></span>
    </div>
</div>

<div class="col-md-3">
    <div class="input-group">
        <select id="trangThai" class="form-select custom-select" onchange="filterByDateHD(1)">
            <option value="">Tất cả</option>
            <option value="Đã thanh toán">Đã thanh toán</option>
            <option value="Chưa thanh toán">Chưa thanh toán</option>
        </select>
    </div>
</div>
</div>

<h1>Danh sách hóa đơn</h1>

<p>
    <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg"></i></a>
</p>

<table id="hoaDonTable" class="table">
    <thead>
        <tr class="table-warning">
            <th>
                Mã hóa đơn
            </th>
            <th>
                Ngày tạo
            </th>
            <th>
                Ngày đến hạn
            </th>
            <th>
                Ngày thanh toán
            </th>
            <th>
                Chỉ số cũ
            </th>
            <th>
                Chỉ số mới
            </th>
            <th>
                Chỉ số tiêu thụ
            </th>
            <th>
                Thuế
            </th>
            <th>
                Số nợ
            </th>
            <th>
                Số tiền cần thanh toán
            </th>
            <th>
                Số tiền đã thanh toán
            </th>
            <th>
                Phương pháp thanh toán
            </th>
            <th>
                Mã đồng hồ
            </th>
            <th>
                Trạng thái
            </th>
            <th>
                Mã khách hàng
            </th>
            <th>
                Họ và tên
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>

        @{
            int i = 0;
            string @cls = "table-success";
            int j = 0;

        }
        @foreach (var item in Model)
        {
            i = i + 1;
            cls = "table-success";
            if (i % 2 == 0)
            {
                cls = "table-primary";
            }
            <tr class="@cls">
                <td>
                    @Html.DisplayFor(modelItem => item.MaHd)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayTao)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayDenHan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayThanhToan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChiSoCu)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChiSoMoi)
                </td>
                <td>
                    @(item.ChiSoMoi - item.ChiSoCu)
                </td>
                <td>
                    @if (ViewBag.ListThue != null && j < ViewBag.ListThue.Count) // Kiểm tra ViewBag.ListThue có tồn tại và không trống
                    {
                        @string.Format("{0:N0}", ViewBag.ListThue[j])
                        j++;
                    }
                </td>

                <td>
                    @string.Format("{0:N0}", item.SoNo)
                </td>
                <td>
                    @string.Format("{0:N0}", item.SoTienCanThanhToan)
                </td>
                <td>
                    @string.Format("{0:N0}", item.SoTienDaThanhToan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaPtttoanNavigation.PhuongPhapTt)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaChiTietSddienNavigation.MaDh)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TrangThai)
                </td>
                <td>
                       
                    @Html.DisplayFor(modelItem => item.MaChiTietSddienNavigation.MaDhNavigation.MaKh)
                        
                </td>
                <td>

                    @Html.DisplayFor(modelItem => item.MaChiTietSddienNavigation.MaDhNavigation.MaKhNavigation.Ho) @Html.DisplayFor(modelItem => item.MaChiTietSddienNavigation.MaDhNavigation.MaKhNavigation.Ten)

                </td>
                

                <td>
                    
                    <a class="btn btn-danger btn-sm rounded" asp-action="Edit" asp-route-id="@item.MaHd">
                        <i class="bi bi-pencil"></i>
                    </a> |

                    <a onclick="if (confirm('Xác nhận xóa hóa đơn này hay không?') == true)
                        {location.href='/admin/Hoadon/Xoa/@item.MaHd'}" class="btn btn-danger btn-sm rounded">
                        <i class="bi bi-x-circle"></i>
                    </a> |
                    @if (item.TrangThai == "Chưa thanh toán")
                    {   
                        <a class="btn btn-danger btn-sm rounded" asp-controller="HomeAdmin" asp-action="ThanhToan" asp-route-maHd="@item.MaHd"><i class="bi bi-cash"></i></a>

                    }
                </td>
            </tr>
            
        }
    </tbody>
</table>
<div class="center" id="paginationContainerA">
    @Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }), new PagedListRenderOptions
{
    LiElementClasses = new string[] { "page-item" },
    PageClasses = new string[] { "page-link" }
})
</div>
@section Scripts {
    <link href='https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/themes/ui-lightness/jquery-ui.css'
          rel='stylesheet'>

    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-ui.min.js"></script>
    <script src="~/Scripts/datepicker-vi.js"></script>
    <script>
        jQuery(document).ready(function ($) {
            $("#my_date_picker, #my_date_picker1").datepicker({
                dateFormat: "yy-mm-dd",
                changeMonth: true,
                changeYear: true
            });

            // Bind event handler for changing trạng thái
            $('#trangThai').change(function () {
                updateFilterValues(); // Gọi hàm cập nhật giá trị lọc
            });

            // Update filter values and trigger filter when datepicker values change
            $('#my_date_picker, #my_date_picker1').change(function () {
                updateFilterValues(); // Gọi hàm cập nhật giá trị lọc
            });

            // Trigger filter on page load (optional)
            updateFilterValues();
        });

        // Function to update filter values
        function updateFilterValues() {
            fromDate = $('#my_date_picker').val();
            toDate = $('#my_date_picker1').val();
            trangThai = $('#trangThai').val();

            // Update pagination links
            updatePaginationLinks(1); // Gọi hàm cập nhật link phân trang
        }

        // Function to update pagination links
        function updatePaginationLinks(pageNumber) {
            // Update URL for pagination links including fromDate, toDate, and trangThai parameters
            var url = '/admin/Hoadon/LocChiTietHD?page=' + pageNumber + '&fromDate=' + fromDate + '&toDate=' + toDate + '&trangThai=' + trangThai;
            $.get(url, function (data) {
                $('#hoaDonTable').html($(data).find('#hoaDonTable').html());
                $('#paginationContainerA').html($(data).find('#paginationContainerA').html());
            });
        }

        // Bind event handler for pagination links
        $(document).on('click', '#paginationContainerA a', function (e) {
            e.preventDefault(); // Prevent default behavior of the pagination links
            var pageUrl = $(this).attr('href');
            var pageNumber = pageUrl.substring(pageUrl.indexOf('page=') + 5);
            updatePaginationLinks(pageNumber);
        });

        // Function to filter by Mã hóa đơn
        function filterByMaHoaDon() {
            var maHoaDon = $('#txtMaHoaDon').val();
            $.ajax({
                url: '/admin/Hoadon/LocChiTietHD',
                type: 'GET',
                data: {
                    maHoaDon: maHoaDon,
                    fromDate: fromDate,
                    toDate: toDate,
                    trangThai: trangThai,
                    page: 1
                },
                success: function (data) {
                    $('#hoaDonTable').html($(data).find('#hoaDonTable').html());
                    $('#paginationContainerA').html($(data).find('#paginationContainerA').html());
                },
                error: function (xhr, status, error) {
                    console.error(error);
                }
            });
        }

        // Function to filter by date
        function filterByDateHD(pageNumber) {
            $.ajax({
                url: '/admin/Hoadon/LocChiTietHD',
                type: 'GET',
                data: {
                    fromDate: fromDate,
                    toDate: toDate,
                    trangThai: trangThai,
                    page: pageNumber
                },
                success: function (data) {
                    $('#hoaDonTable').html($(data).find('#hoaDonTable').html());
                    $('#paginationContainerA').html($(data).find('#paginationContainerA').html());
                },
                error: function (xhr, status, error) {
                    console.error(error);
                }
            });
        }

    </script>
}



