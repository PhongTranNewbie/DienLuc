@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<HoaDon>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

    var dhd = ViewBag.DHD as List<DienLuc.Models.DongHoDien>;
}

<h1>Danh sách hóa đơn</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Thêm mới</a>
</p>

<table class="table">
    <thead>
        <tr class="table-warning">
            <th>
                Ngày tạo
            </th>
            <th>
                Ngày đến hạn
            </th>
            <th>
                Ngày thanh toán
            </th>
            <th>
                Chỉ số cũ
            </th>
            <th>
                Chỉ số mới
            </th>
            <th>
                Chỉ số tiêu thụ
            </th>
            <th>
                Số tiền cần thanh toán
            </th>
            <th>
                Số tiền đã thanh toán
            </th>
            <th>
                Mã đồng hồ
            </th>
            <th>
                Mã khách hàng
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 0;
            string @cls = "table-success";
        }
        @foreach (var item in Model)
        {
            i = i + 1;
            cls = "table-success";
            if (i % 2 == 0)
            {
                cls = "table-primary";
            }
            <tr class="@cls">
                <td>
                    @Html.DisplayFor(modelItem => item.NgayTao)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayDenHan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayThanhToan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChiSoCu)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChiSoMoi)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChiSoTieuThu)
                </td>
                <td>
                    @string.Format("{0:N0}", item.SoTienCanThanhToan)
                </td>
                <td>
                    @string.Format("{0:N0}", item.SoTienDaThanhToan)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.MaChiTietSddienNavigation.MaDh)
                </td>
                
                <td>
                       
                            @Html.DisplayFor(modelItem => item.MaChiTietSddienNavigation.MaDhNavigation.MaKh)
                        
                </td>

                

                <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.MaHd">Chỉnh sửa</a> |
                    <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.MaHd">Chi tiết</a> |
                    <a class="btn btn-primary" asp-action="Delete" asp-route-id="@item.MaHd">Xóa</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }), new PagedListRenderOptions
{
    LiElementClasses = new string[] { "page-item" },
    PageClasses = new string[] { "page-link" }
})