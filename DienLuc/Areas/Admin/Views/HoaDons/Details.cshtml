@model DienLuc.Models.HoaDon

@{
    ViewData["Title"] = "Details";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

}

<div class="page-header">
    <nav style="--cui-breadcrumb-divider: '>';" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Danh sách đồng hồ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết hóa đơn</li>
        </ol>
    </nav>
</div>

<div>
    <h4>Chi tiết hóa đơn</h4>
    <hr />
    <dl class="row">
        <div class="row">
            <div class="col-sm-auto">
                <label for="NgayTao" class="col-form-label">Ngày tạo</label>
                <input type="text" id="NgayTao" class="form-control" value="@Model.NgayTao" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="NgayDenHan" class="col-form-label">Ngày đến hạn</label>
                <input type="text" id="NgayDenHan" class="form-control" value="@Model.NgayDenHan" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="NgayThanhToan" class="col-form-label">Ngày thanh toán</label>
                <input type="text" id="NgayThanhToan" class="form-control" value="@Model.NgayThanhToan" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="Thue" class="col-form-label">Thuế</label>
                <input type="text" id="Thue" class="form-control" value="@Model.Thue" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="SoNo" class="col-form-label">Số nợ</label>
                <input type="text" id="SoNo" class="form-control" value="@Model.SoNo" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="SoTienCanThanhToan" class="col-form-label">Số tiền cần thanh toán</label>
                <input type="text" id="SoTienCanThanhToan" class="form-control" value="@Model.SoTienCanThanhToan" readonly>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-auto">
                <label for="SoTienDaThanhToan" class="col-form-label">Số tiền đã thanh toán</label>
                <input type="text" id="SoTienDaThanhToan" class="form-control" value="@Model.SoTienDaThanhToan" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="HinhThucThanhToan" class="col-form-label">Hình thức thanh toán</label>
                <input type="text" id="HinhThucThanhToan" class="form-control" value="@Model.HinhThucThanhToan" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="TrangThai" class="col-form-label">Trạng thái</label>
                <input type="text" id="TrangThai" class="form-control" value="@Model.TrangThai" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="MaChiTietSddien" class="col-form-label">Mã đồng hồ</label>
                <input type="text" id="MaChiTietSddien" class="form-control" value="@Model.MaChiTietSddienNavigation.MaDh" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="MaChiTietSddien" class="col-form-label">Mã khách hàng</label>
                <input type="text" id="MaChiTietSddien" class="form-control" value="@Model.MaChiTietSddienNavigation.MaDhNavigation.MaKh" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="MaChiTietSddien" class="col-form-label">Mã chi tiết sử dụng điện</label>
                <input type="text" id="MaChiTietSddien" class="form-control" value="@Model.MaChiTietSddien" readonly>
            </div>
            <div class="col-sm-auto">
                <label for="MaNv" class="col-form-label">Mã nhân viên</label>
                <input type="text" id="MaNv" class="form-control" value="@Model.MaNvNavigation?.MaNv" readonly>
            </div>

        </div>

        

    </dl>

</div>
<div>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.MaHd">Chỉnh sửa</a> 
    
</div>
