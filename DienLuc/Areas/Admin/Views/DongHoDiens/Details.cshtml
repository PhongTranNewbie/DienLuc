@model DienLuc.Models.DongHoDien

@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";
}


<div class="page-header">
    <nav style="--cui-breadcrumb-divider: '>';" aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Danh sách đồng hồ</a></li>
            <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
        </ol>
    </nav>
</div>
<div>
    <h1>Chi tiết đồng hồ</h1>

    <hr />
    <dl class="row">
        <div class="col-sm-auto">
            <label for="MaDh" class="col-form-label">Mã đồng hồ</label>
            <input type="text" id="MaDh" class="form-control" value="@Model.MaDh" readonly>
        </div>
        <div class="col-sm-auto">
            <label for="MaKh" class="col-form-label">Mã khách hàng</label>
            <input type="text" id="MaKh" class="form-control" value="@Model.MaKh" readonly>
        </div>
        <div class="col-sm-auto">
            <label for="TrangThai" class="col-form-label">Trạng thái</label>
            <input type="text" id="TrangThai" class="form-control" value="@Model.TrangThai" readonly>
        </div>
        <div class="col-sm-auto">
            <label for="NgayCapNhatTrangThai" class="col-form-label">Ngày cập nhật trạng thái</label>
            <input type="text" id="NgayCapNhatTrangThai" class="form-control" value="@Model.NgayCapNhatTrangThai" readonly>
        </div>
        <div class="col-sm-auto">
            <label for="LoaiDhd" class="col-form-label">Loại đồng hồ</label>
            <input type="text" id="LoaiDhd" class="form-control" value="@Model.LoaiDhd" readonly>
        </div>
    </dl>
</div>
<div>
    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model?.MaDh">Chỉnh sửa</a>
</div>
