@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<DongHoDien>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

}

<h1>Danh sách đồng hồ</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Tạo mới</a>
</p>
<table class="table">
    <thead>
        <tr class="table-warning">
            <th>
                Mã đồng hồ
            </th>
            <th>
                Mã khách hàng
            </th>
            <th>
                Trạng thái
            </th>
            <th>
                Ngày cập nhật trạng thái
            </th>
            <th>
                Loại đồng hồ
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 0;
            string @cls = "table-success";
        }
@foreach (var item in Model) {
            i = i + 1;
            cls = "table-success";
            if (i % 2 == 0)
            {
                cls = "table-primary";
            }
        <tr class="@cls">
            <td>
                    @Html.DisplayFor(modelItem => item.MaDh)

            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.MaKh)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.TrangThai)
            </td>
                
            <td>
                @Html.DisplayFor(modelItem => item.NgayCapNhatTrangThai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.LoaiDhd)
            </td>
            <td>
                    <a class="btn btn-primary" asp-action="Edit" asp-route-id="@item.MaDh">Chỉnh sửa</a> |
                    <a class="btn btn-primary" asp-action="Details" asp-route-id="@item.MaDh">Chi tiết</a> |
                    <a class="btn btn-primary" asp-action="Delete" asp-route-id="@item.MaDh">Xóa</a>
            </td>
        </tr>
}
    </tbody>
</table>
@Html.PagedListPager(Model, page => Url.Action("Index", new { page = page }), new PagedListRenderOptions
{
    LiElementClasses = new string[] { "page-item" },
    PageClasses = new string[] { "page-link" }
})