@model DienLuc.Models.HoaDon
@{
    Layout = "~/Areas/Admin/Views/Shared/_LayoutAdmin.cshtml";

}
<h2>Thanh toán hóa đơn</h2>

@if (ViewData.ModelState.IsValid)
{
    <p>@ViewData.ModelState[""]</p>
}

<div>


    <h4>Thông tin hóa đơn:</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Mã hóa đơn:</dt>
        <dd class="col-sm-10">@Model.MaHd</dd>
        <dt class="col-sm-2">Chỉ số cũ:</dt>
        <dd class="col-sm-10">@Model.ChiSoCu</dd>
        <dt class="col-sm-2">Chỉ số mới:</dt>
        <dd class="col-sm-10">@Model.ChiSoMoi</dd>
        <dt class="col-sm-2">Chỉ số tiêu thụ:</dt>
        <dd class="col-sm-10">@(Model.ChiSoMoi - Model.ChiSoCu)</dd>
        @if (ViewBag.SoTienTruocThue != null)
        {
            <dt class="col-sm-2">Số tiền trước thuế:</dt>

            <dd class="col-sm-10">@string.Format("{0:N0}", ViewBag.SoTienTruocThue)</dd>

        }

        @if (ViewBag.ThueTien != null)
        {
            <dt class="col-sm-2">Tiền thuế:</dt>

            <dd class="col-sm-10">@string.Format("{0:N0}", ViewBag.ThueTien)</dd>

        }
        <dt class="col-sm-2">Số tiền cần thanh toán:</dt>
        <dd class="col-sm-10">@string.Format("{0:N0}", Model.SoTienCanThanhToan)</dd>

    </dl>
</div>

<form asp-action="ThanhToan">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <select class="form-control" id="pttt" name="PTTT">
        @foreach (var pttt in ViewBag.PTTT)
        {
            <option value="@pttt.MaPttt">@pttt.PhuongPhapTt</option>
        }
    </select>
    <div class="form-group">
        <label for="soTienThanhToan">Số tiền thanh toán:</label>
        <input type="number" id="soTienThanhToan" name="SoTienThanhToan" class="form-control" />
        <input type="hidden" id="maHd" name="maHd" value="@Model.MaHd" />
        <input type="hidden" id="maDh" name="Mã đồng hồ" value="@Model.MaChiTietSddienNavigation?.MaDh ?? string.Empty"
               class="form-control" />
    </div>
    <button type="submit" class="btn btn-primary">Hoàn thành thanh toán</button>
</form>
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }



}
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></select>