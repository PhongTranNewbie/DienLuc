@model DienLuc.ViewModels.TaiKhoanKhachHangViewModel

@{
    ViewData["Title"] = "Đăng ký";
    Layout = "~/Areas/KhachHang/Views/Shared/DK.cshtml";

}
<h1>Công ty điện lực</h1>
<h2>Đăng ký cho khách hàng</h2>

<form asp-action="DangKy" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-group">
        <label for="MaTk">Mã tài khoản:</label>
        <input type="text" id="MaTk" name="MaTk" class="form-control" required>
        <span asp-validation-for="MaTk" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label for="Mk">Mật khẩu:</label>
        <input type="password" id="Mk" name="Mk" class="form-control" required>
        <span asp-validation-for="Mk" class="text-danger"></span>
    </div>

    <!-- Thêm các trường thông tin nhân viên -->
    <div class="form-group">
        <label for="Cccd">CCCD:</label>
        <input type="text" id="Cccd" name="Cccd" class="form-control" required>
        <span asp-validation-for="Cccd" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="Ho">Họ:</label>
        <input type="text" id="Ho" name="Ho" class="form-control" required>
        <span asp-validation-for="Ho" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="Ten">Tên:</label>
        <input type="text" id="Ten" name="Ten" class="form-control" required>
        <span asp-validation-for="Ten" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="NgaySinh">Ngày sinh:</label>
        <input type="date" id="NgaySinh" name="NgaySinh" class="form-control" required>
        <span asp-validation-for="NgaySinh" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="DiaChi">Địa chỉ:</label>
        <input type="text" id="DiaChi" name="DiaChi" class="form-control" required>
        <span asp-validation-for="DiaChi" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="SoDt">Số điện thoại:</label>
        <input type="text" id="SoDt" name="SoDt" class="form-control" required>
        <span asp-validation-for="SoDt" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label for="MaThue">Mã thuế:</label>
        <input type="text" id="MaThue" name="MaThue" class="form-control" required>
        <span  class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Đăng ký</button>
</form>
