@model DienLuc.Models.KhachHang
@{
    ViewData["Title"] = "Thông tin";
    Layout = "~/Areas/KhachHang/Views/Shared/_LayoutKH.cshtml";

    var dhd = ViewBag.DHD as List<DienLuc.Models.DongHoDien>;
}
<!DOCTYPE html>
<html>
<head>
    <title>Thông tin khách hàng</title>
</head>
<body>
    <h2>Thông tin khách hàng</h2>
    <ul>
        <li><strong>Mã khách hàng:</strong> @Model.MaKh</li>
        <li><strong>Họ:</strong> @Model.Ho</li>
        <li><strong>Tên:</strong> @Model.Ten</li>
        <li><strong>Ngày sinh:</strong> @Model.NgaySinh</li>
        <li><strong>Địa chỉ:</strong> @Model.DiaChi</li>
        <li><strong>Số điện thoại:</strong> @Model.SoDt</li>
        <li><strong>Mã số thuế:</strong> @Model.MaThue</li>
        <!-- Thêm các thông tin khác của khách hàng nếu cần -->
    </ul>
    <a asp-action="ChinhSuaThongTin" asp-controller="TaiKhoan" class="btn btn-primary">Chỉnh sửa thông tin</a>

</body>
</html>
