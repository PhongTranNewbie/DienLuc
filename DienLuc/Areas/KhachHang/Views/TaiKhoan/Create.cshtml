@model DienLuc.Models.TaiKhoan

@{
    ViewData["Title"] = "Create";
    Layout = "~/Areas/KhachHang/Views/Shared/_LayoutLoginKH.cshtml";
}

<h3 class="font-weight-light" style="margin-block:15px;">Đăng ký tài khoản</h3>

@using (Html.BeginForm("Create", "TaiKhoan", FormMethod.Post))
{
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="form-group">
        @Html.TextBoxFor(x => x.MaTk, new { @class = "form-control form-control-lg", placeholder = "Tên tài khoản", required = "required", autofocus = "autofocus" })
    </div>
    <div class="form-group">
        @Html.PasswordFor(x => x.Mk, new { @class = "form-control form-control-lg", placeholder = "Mật khẩu", required = "required" })
    </div>
    <div class="mt-3">
        <button class="btn btn-block btn-lg font-weight-medium auth-form-btn custom-btn" type="submit">Đăng ký</button>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
