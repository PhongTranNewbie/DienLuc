@using DienLuc.Models;
@{
    Layout = "~/Areas/KhachHang/Views/Shared/_LayoutLoginKH.cshtml";
}

@model TaiKhoan

<div asp-validation-summary="All" class="text-danger"></div>

<h3 class="font-weight-light" style="margin-block:15px;">Đăng nhập để tiếp tục</h3>

@using (Html.BeginForm("Login", "TaiKhoan", FormMethod.Post))
{
    <div class="form-group">
        @Html.TextBoxFor(x => x.MaTk, new { @class = "form-control form-control-lg", placeholder = "Tên tài khoản", required = "required", autofocus = "autofocus" })
    </div>
    <div class="form-group">
        @Html.PasswordFor(x => x.Mk, new { @class = "form-control form-control-lg", placeholder = "Mật khẩu", required = "required" })
    </div>
    <div class="mt-3">
        <button class="btn btn-block btn-lg font-weight-medium auth-form-btn custom-btn" type="submit">Đăng nhập</button>
    </div>
}
@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}