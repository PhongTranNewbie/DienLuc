@using X.PagedList.Mvc.Core;
@model X.PagedList.IPagedList<HoaDon>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/KhachHang/Views/Shared/_LayoutKH.cshtml";

    var dhd = ViewBag.DHD as List<DienLuc.Models.DongHoDien>;
}

<h1>Danh sách hóa đơn</h1>

<table id="dha" class="table">
    <thead>
        <tr class="table-warning">
            <th>
                Mã hóa đơn
            </th>
            <th>
                Ngày tạo
            </th>
            <th>
                Ngày đến hạn
            </th>
            <th>
                Ngày thanh toán
            </th>
            <th>
                Chỉ số cũ
            </th>
            <th>
                Chỉ số mới
            </th>
            <th>
                Chỉ số tiêu thụ
            </th>
            <th>
                Thuế
            </th>
            <th>
                Số nợ
            </th>
            <th>
                Số tiền cần thanh toán
            </th>
            <th>
                Số tiền đã thanh toán
            </th>

            <th>
                Mã đồng hồ
            </th>
            <th>
                Trạng thái
            </th>

        </tr>
    </thead>
    <tbody>
        @{
            int i = 0;
            string @cls = "table-success";
            int j = 0;
        }
        @foreach (var item in Model)
        {
            i = i + 1;
            cls = "table-success";
            if (i % 2 == 0)
            {
                cls = "table-primary";
            }
            <tr class="@cls">
                <td>
                    @Html.DisplayFor(modelItem => item.MaHd)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayTao)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayDenHan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.NgayThanhToan)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChiSoCu)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ChiSoMoi)
                </td>
                <td>
                    @(item.ChiSoMoi - item.ChiSoCu)
                </td>
                <td>
                    @if (j < ViewBag.ListThue.Count) // Kiểm tra chỉ mục trước khi truy cập
                    {

                        @string.Format("{0:N0}", ViewBag.ListThue[j])
                        j++;
                    }
                </td>
                <td>
                    @string.Format("{0:N0}", item.SoNo)
                </td>
                <td>
                    @string.Format("{0:N0}", item.SoTienCanThanhToan)
                </td>
                <td>
                    @string.Format("{0:N0}", item.SoTienDaThanhToan)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.MaChiTietSddienNavigation.MaDh)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.TrangThai)
                </td>




            </tr>
        }
    </tbody>
</table>
<div class="center" id="paginationContainer1a">
    @Html.PagedListPager(Model, page => Url.Action("HoaDon", new { page = page }), new PagedListRenderOptions
{
    LiElementClasses = new string[] { "page-item" },
    PageClasses = new string[] { "page-link" }
})
</div>
@section Scripts {
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"></script>
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>

        // Biến toàn cục để lưu trữ ID của setTimeout
        var timeoutId;

        // Function để lọc dữ liệu bằng mã đồng hồ
        function filterByMaHoaDon() {
            // Xóa timeout trước đó nếu có
            clearTimeout(timeoutId);

            // Lấy giá trị mã đồng hồ
            var mahd = $('#txtMaHoaDon').val();

            // Thiết lập timeout để gửi yêu cầu Ajax sau 500ms khi không có thêm ký tự mới được nhập vào
            timeoutId = setTimeout(function () {
                $.ajax({
                    url: '/khachhang/thanhtoan/TBHD',
                    type: 'GET',
                    data: { mahd: mahd, page: 1 },
                    success: function (result) {
                        $('#dha tbody').html($(result).find('tbody').html());
                        $('#paginationContainer1a').html($(result).find('#paginationContainer1a').html());
                    },
                    error: function () {
                        console.log('Đã xảy ra lỗi khi lấy dữ liệu từ máy chủ.');
                    }
                });
            }, 500); // Chờ 500ms trước khi gửi yêu cầu Ajax
        }
        function updateData(pageNumber) {
            var mahd = $('#txtMaHoaDon').val();


            $.ajax({
                url: '/khachhang/thanhtoan/TBHD',
                type: 'GET',
                data: { mahd: mahd, page: pageNumber },
                success: function (result) {
                    $('#dha tbody').html($(result).find('tbody').html());
                    $('#paginationContainer1a').html($(result).find('#paginationContainer1a').html());
                },
                error: function () {
                    console.log('Đã xảy ra lỗi khi lấy dữ liệu từ máy chủ.');
                }
            });
        }

        // Bind sự kiện cho các liên kết phân trang
        $(document).on('click', '#paginationContainer1a a', function (e) {
            e.preventDefault(); // Ngăn chặn hành vi mặc định của các liên kết phân trang
            var pageUrl = $(this).attr('href');
            var pageNumber = pageUrl.substring(pageUrl.indexOf('page=') + 5);
            updateData(pageNumber); // Gọi hàm để cập nhật dữ liệu khi người dùng chuyển trang
        });
    </script>

}