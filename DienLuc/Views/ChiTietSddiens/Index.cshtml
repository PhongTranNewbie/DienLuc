@model IEnumerable<DienLuc.Models.ChiTietSddien>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Id
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChiSoCu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChiSoMoi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ChiSoTieuThu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaDhNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaNvNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ChiSoCu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ChiSoMoi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ChiSoTieuThu)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaDhNavigation.MaDh)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaNvNavigation.MaNv)
            </td>
            <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
