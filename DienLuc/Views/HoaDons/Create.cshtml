@model DienLuc.Models.HoaDon

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>HoaDon</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="MaHd" class="control-label"></label>
                <input asp-for="MaHd" class="form-control" />
                <span asp-validation-for="MaHd" class="text-danger"></span>
            </div>
            
            <div class="form-group">
                <label class="control-label">Mã khách hàng</label>
                <input id="MaKh" class="form-control" readonly />
            </div>
            <div class="form-group">
                <label class="control-label">Mã đồng hồ</label>
                <input id="MaDh" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="MaChiTietSddien" class="control-label"></label> 
                <select id="MaChiTietSddien" name="MaChiTietSddien" asp-for="MaChiTietSddien" class="form-control" asp-items="ViewBag.MaChiTietSddien"></select>
            </div>
            <div class="form-group">
                <label asp-for="NgayTao" class="control-label"></label>
                <input asp-for="NgayTao" class="form-control" />
                <span asp-validation-for="NgayTao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ChiSoCu" class="control-label"></label>
                <input asp-for="ChiSoCu" class="form-control" readonly />
                <span asp-validation-for="ChiSoCu" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ChiSoMoi" class="control-label"></label>
                <input asp-for="ChiSoMoi" class="form-control" />
                <span asp-validation-for="ChiSoMoi" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ChiSoTieuThu" class="control-label"></label>
                <input asp-for="ChiSoTieuThu" class="form-control" />
                <span asp-validation-for="ChiSoTieuThu" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NgayDenHan" class="control-label"></label>
                <input asp-for="NgayDenHan" class="form-control" />
                <span asp-validation-for="NgayDenHan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NgayThanhToan" class="control-label"></label>
                <input asp-for="NgayThanhToan" class="form-control" />
                <span asp-validation-for="NgayThanhToan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Thue" class="control-label"></label>
                <input asp-for="Thue" class="form-control" />
                <span asp-validation-for="Thue" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SoNo" class="control-label"></label>
                <input asp-for="SoNo" class="form-control" />
                <span asp-validation-for="SoNo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SoTienCanThanhToan" class="control-label"></label>
                <input asp-for="SoTienCanThanhToan" class="form-control" />
                <span asp-validation-for="SoTienCanThanhToan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="SoTienDaThanhToan" class="control-label"></label>
                <input asp-for="SoTienDaThanhToan" class="form-control" />
                <span asp-validation-for="SoTienDaThanhToan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="HinhThucThanhToan" class="control-label"></label>
                <input asp-for="HinhThucThanhToan" class="form-control" />
                <span asp-validation-for="HinhThucThanhToan" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TrangThai" class="control-label"></label>
                <select asp-for="TrangThai" class="form-control">
                    <option value="Chưa thanh toán">Chưa thanh toán</option>
                    <option value="Đã thanh toán">Đã thanh toán</option>
                    <option value="Còn nợ">Còn nợ</option>
                    <option value="Đã chuyển vào hóa đơn tiếp theo">Đã chuyển vào hóa đơn tiếp theo</option>
                </select>
                <span asp-validation-for="TrangThai" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>

            $(document).ready(function () {
                // Gán sự kiện thay đổi cho ô input NgayTao
                $('#MaChiTietSddien').change(function () {
                    var maChiTietSddien = $('#MaChiTietSddien').val();  // Sử dụng id của dropdown list

                    // Gửi yêu cầu AJAX để lấy dữ liệu từ máy chủ (ChiSoThangTruoc)
                    $.ajax({
                        url: '/HoaDons/GetChiSoThangTruoc',
                        type: 'GET',
                        data: { maChiTietSddien: maChiTietSddien },
                        success: function (data) {
                            // Cập nhật các ô chỉ số trên giao diện
                            $('#ChiSoCu').val(data.chiSoCu);
                            $('#ChiSoMoi').val(data.chiSoMoi);
                            $('#ChiSoTieuThu').val(data.chiSoTieuThu);
                        },
                        error: function () {
                            console.log('Đã xảy ra lỗi khi lấy dữ liệu từ máy chủ.');
                        }
                    });

                    // Gửi yêu cầu AJAX để lấy mã đồng hồ và mã khách hàng từ máy chủ (GetMeterAndCustomerCode)
                    $.ajax({
                        url: '/HoaDons/GetMeterAndCustomerCode',
                        type: 'GET',
                        data: { maChiTietSddien: maChiTietSddien },
                        success: function (data) {
                            $('#MaKh').val(data.maKh);
                            $('#MaDh').val(data.maDh);
                        },
                        error: function () {
                            console.log('An error occurred while fetching meter code and customer code.');
                        }
                    });
                });
            });
    </script>




}
