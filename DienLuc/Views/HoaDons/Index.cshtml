            <td>
                @Html.DisplayFor(modelItem => item.SoTienDaThanhToan)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.HinhThucThanhToan)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.TrangThai)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MaChiTietSddienNavigation.MaDh)
