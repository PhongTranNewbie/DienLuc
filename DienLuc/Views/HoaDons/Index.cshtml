            <th>
                @Html.DisplayNameFor(model => model.SoTienDaThanhToan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.HinhThucThanhToan)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThai)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaChiTietSddienNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaKhNavigation)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaNvNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
